# Database
DATABASE_URL=sqlite:///./fedbank.db
# For Docker/Production: postgresql://fedbank:fedbank@postgres:5432/fedbank

# JWT
JWT_SECRET=change-this-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRATION=30
JWT_REFRESH_EXPIRATION=10080

# MLflow
MLFLOW_TRACKING_URI=./mlruns

# Federated Learning
FEDERATED_SERVER_HOST=0.0.0.0
FEDERATED_SERVER_PORT=8080

# Storage
MODEL_STORAGE_PATH=./model_storage
REPORT_STORAGE_PATH=./report_storage
DATASET_STORAGE_PATH=./dataset_storage

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
